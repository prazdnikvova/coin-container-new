        {
            "key": "field_ccn_tab_landing",
            "label": "Landing sidebar",
            "name": "",
            "type": "tab",
            "placement": "top",
            "endpoint": 0
        },
        {
            "key": "field_ccn_landing_services",
            "label": "Service links",
            "name": "landing_services",
            "type": "repeater",
            "instructions": "\"Unsere Dienstleistungen\" list on landing pages. The link matching the current page is hidden automatically.",
            "layout": "table",
            "button_label": "Add link",
            "sub_fields": [
                {
                    "key": "field_ccn_landing_service_label",
                    "label": "Label",
                    "name": "label",
                    "type": "text"
                },
                {
                    "key": "field_ccn_landing_service_url",
                    "label": "URL",
                    "name": "url",
                    "type": "text"
                }
            ]
        },
        {
            "key": "field_ccn_landing_card_title",
            "label": "Card title",
            "name": "landing_card_title",
            "type": "text",
            "instructions": "\"Ihr Containerprojekt beginnt hier\" card under the service links."
        },
        {
            "key": "field_ccn_landing_card_button_text",
            "label": "Card button text",
            "name": "landing_card_button_text",
            "type": "text"
        },
        {
            "key": "field_ccn_landing_card_button_url",
            "label": "Card button URL",
            "name": "landing_card_button_url",
            "type": "text"
        },
        {
            "key": "field_ccn_tab_trust",
            "label": "Vertrauen",
            "name": "",
            "type": "tab",
            "placement": "top",
            "endpoint": 0
        },
        {
            "key": "field_ccn_trustpilot_rating",
            "label": "Trustpilot rating",
            "name": "trustpilot_rating",
            "type": "number",
            "instructions": "TrustScore as on the Trustpilot profile, e.g. 4.5 (hero trust row; trust blocks). The label follows Trustpilot's bands: from 4.5 \"Hervorragend\", from 4.0 \"Sehr gut\".",
            "min": 0,
            "max": 5,
            "step": 0.1
        },
        {
            "key": "field_ccn_trustpilot_count",
            "label": "Trustpilot review count",
            "name": "trustpilot_count",
            "type": "number",
            "min": 0,
            "step": 1
        },
        {
            "key": "field_ccn_trustpilot_url",
            "label": "Trustpilot profile URL",
            "name": "trustpilot_url",
            "type": "url"
        },
        {
            "key": "field_ccn_google_rating",
            "label": "Google rating",
            "name": "google_rating",
            "type": "number",
            "instructions": "Leave empty to show the review count only (as on production).",
            "min": 0,
            "max": 5,
            "step": 0.1
        },
        {
            "key": "field_ccn_google_count",
            "label": "Google review count",
            "name": "google_count",
            "type": "number",
            "min": 0,
            "step": 1
        },
        {
            "key": "field_ccn_google_url",
            "label": "Google reviews URL",
            "name": "google_url",
            "type": "url"
        },
        {
            "key": "field_ccn_badge_image",
            "label": "Badge image",
            "name": "badge_image",
            "type": "image",
            "instructions": "Seal with alt text. The hero prints the badge as text (no image in the first screen) and reads the alt as screen-reader text; the image is for the trust blocks and the certificates page.",
            "return_format": "id",
            "preview_size": "thumbnail"
        },
        {
            "key": "field_ccn_badge_text",
            "label": "Badge text",
            "name": "badge_text",
            "type": "text"
        },
        {
            "key": "field_ccn_badge_url",
            "label": "Badge link",
            "name": "badge_url",
            "type": "text",
            "instructions": "Path or URL, e.g. /ueber-uns/zertifikate/."
        },
        {
            "key": "field_ccn_trustpilot_businessunit",
            "label": "Trustpilot business unit ID",
            "name": "trustpilot_businessunit",
            "type": "text",
            "instructions": "Public ID of the Trustpilot profile for the TrustBox in the reviews block (template Review Collector: the only TrustBox this profile's plan allows, measured 08.11.2026). Empty = no TrustBox.",
            "default_value": "69de1de21f8d1dd5b20d29b5"
        },
        {
            "key": "field_ccn_key_facts",
            "label": "Key facts",
            "name": "key_facts",
            "type": "repeater",
            "instructions": "Up to three figures for the trust bar (e.g. years, customers). Only figures with a source: the source is required and never displayed.",
            "layout": "table",
            "max": 3,
            "button_label": "Add fact",
            "sub_fields": [
                {
                    "key": "field_ccn_key_fact_number",
                    "label": "Number",
                    "name": "number",
                    "type": "number",
                    "required": 1
                },
                {
                    "key": "field_ccn_key_fact_suffix",
                    "label": "Suffix",
                    "name": "suffix",
                    "type": "text",
                    "instructions": "e.g. +"
                },
                {
                    "key": "field_ccn_key_fact_label",
                    "label": "Label",
                    "name": "label",
                    "type": "text",
                    "required": 1
                },
                {
                    "key": "field_ccn_key_fact_source",
                    "label": "Source (not displayed)",
                    "name": "source",
                    "type": "text",
                    "instructions": "Where the figure comes from, e.g. client decision with date.",
                    "required": 1
                }
            ]
        },
        {
            "key": "field_ccn_tab_schema",
            "label": "Schema",
            "name": "",
            "type": "tab",
            "placement": "top",
            "endpoint": 0
        },
        {
            "key": "field_ccn_faq_schema_mode",
            "label": "FAQ schema",
            "name": "faq_schema_mode",
            "type": "select",
            "instructions": "JSON-LD of the FAQ blocks. Production: the questions inside the WebPage node (mainEntity), no FAQPage node; this mode needs Rank Math (T-54) and prints nothing before. aggregateRating is never printed (team decision 22.09.2026).",
            "choices": {
                "webpage-mainentity": "Questions in WebPage.mainEntity (as on production, via Rank Math)",
                "faqpage": "Own FAQPage node",
                "none": "No FAQ schema"
            },
            "default_value": "webpage-mainentity",
            "return_format": "value",
            "allow_null": 0,
            "multiple": 0,
            "ui": 0
        },
        {
            "key": "field_ccn_tab_cta",
            "label": "Calls to action",
            "name": "",
            "type": "tab",
            "placement": "top",
            "endpoint": 0
        },
        {
            "key": "field_ccn_hero_cta_text",
            "label": "Landing hero button text",
            "name": "hero_cta_text",
            "type": "text",
            "instructions": "Button under the h1 of every landing page (hero band), next to the phone line.",
            "default_value": "Container anfragen"
        },
        {
            "key": "field_ccn_hero_cta_url",
            "label": "Landing hero button URL",
            "name": "hero_cta_url",
            "type": "text",
            "instructions": "Empty = the request page URL below.",
            "default_value": "/container-angebot-anfordern/"
        },
        {
            "key": "field_ccn_anfrage_url",
            "label": "Request page URL",
            "name": "anfrage_url",
            "type": "text",
            "instructions": "\"Anfrage\" button of the bottom action bar on phones (and the landing button when its URL is empty). The bar is hidden on this page itself and on cart, checkout and account.",
            "default_value": "/container-angebot-anfordern/"
        },
        {
            "key": "field_ccn_tab_prices",
            "label": "Preise",
            "name": "",
            "type": "tab",
            "placement": "top",
            "endpoint": 0
        },
        {
            "key": "field_ccn_price_rows",
            "label": "Price ranges",
            "name": "price_rows",
            "type": "repeater",
            "instructions": "One row per container size: the single source of every price table (block Price table; production: transmax-child/inc/preise.php). Whole euros, net, depot prices without transport. Fill both bounds of a range or none: an empty range shows «auf Anfrage».",
            "layout": "table",
            "button_label": "Add size",
            "sub_fields": [
                {
                    "key": "field_ccn_price_size",
                    "label": "Size",
                    "name": "size",
                    "type": "text",
                    "instructions": "As shown in the first column, e.g. 20 Fuß High Cube.",
                    "required": 1
                },
                {
                    "key": "field_ccn_price_used_min",
                    "label": "Used from",
                    "name": "used_min",
                    "type": "number",
                    "min": 0,
                    "step": 1
                },
                {
                    "key": "field_ccn_price_used_max",
                    "label": "Used to",
                    "name": "used_max",
                    "type": "number",
                    "min": 0,
                    "step": 1
                },
                {
                    "key": "field_ccn_price_oneway_min",
                    "label": "One Way from",
                    "name": "oneway_min",
                    "type": "number",
                    "min": 0,
                    "step": 1
                },
                {
                    "key": "field_ccn_price_oneway_max",
                    "label": "One Way to",
                    "name": "oneway_max",
                    "type": "number",
                    "min": 0,
                    "step": 1
                },
                {
                    "key": "field_ccn_price_new_min",
                    "label": "New from",
                    "name": "new_min",
                    "type": "number",
                    "min": 0,
                    "step": 1
                },
                {
                    "key": "field_ccn_price_new_max",
                    "label": "New to",
                    "name": "new_max",
                    "type": "number",
                    "min": 0,
                    "step": 1
                },
                {
                    "key": "field_ccn_price_note",
                    "label": "Note",
                    "name": "note",
                    "type": "text",
                    "instructions": "Optional, a small line under the size."
                }
            ]
        },
        {
            "key": "field_ccn_price_stand",
            "label": "Prices as of",
            "name": "price_stand",
            "type": "text",
            "instructions": "Shown as «Stand: …» under every price table, as typed (production: «Oktober 2026»). Update it with every price change."
        },
        {
            "key": "field_ccn_price_footnote",
            "label": "Price note",
            "name": "price_footnote",
            "type": "textarea",
            "instructions": "Printed after «Stand: …» under every price table (production: net, depot prices, without transport, binding prices only in the offer).",
            "rows": 3,
            "new_lines": ""
        },
        {
            "key": "field_ccn_diesel_surcharge",
            "label": "Diesel surcharge (%)",
            "name": "diesel_surcharge",
            "type": "text",
            "instructions": "Percent without the sign, e.g. 20 (production: 20). Shown in running text through the shortcode [ccn_dieselzuschlag] (transport cost post) as on production: one decimal, a trailing «,0» dropped, then « %». Empty = nothing is shown."
        }
    ],
    "location": [
        [
            {
                "param": "options_page",
                "operator": "==",
                "value": "ccn-site-settings"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true,
    "show_in_rest": 0
}
