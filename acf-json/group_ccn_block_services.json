                {
                    "key": "field_ccn_sv_item_title",
                    "label": "Title",
                    "name": "title",
                    "type": "text",
                    "wrapper": { "width": "25" }
                },
                {
                    "key": "field_ccn_sv_item_text",
                    "label": "Text",
