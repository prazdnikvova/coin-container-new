            "label": "Heading",
            "name": "heading",
            "type": "text",
            "required": 1
        },
        {
            "key": "field_ccn_sv_heading_accent",
            "label": "Heading accent (yellow tail)",
            "name": "heading_accent",
            "type": "text"
        },
        {
            "key": "field_ccn_sv_intro",
            "label": "Intro",
            "name": "intro",
            "type": "textarea",
            "rows": 3
        },
        {
