        {
            "key": "field_ccn_company_name",
            "label": "Company name",
            "name": "company_name",
            "type": "text",
            "instructions": "Legal company name shown in the footer.",
            "required": 0
        },
        {
            "key": "field_ccn_phone",
            "label": "Phone",
            "name": "phone",
            "type": "text",
            "instructions": "Shown as typed in header, hero, footer and contact cards (production format: +49 (40) 561 236 56); tel: links keep only the digits and +.",
            "required": 0
        },
        {
            "key": "field_ccn_email",
            "label": "Email",
            "name": "email",
