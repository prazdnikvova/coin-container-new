                    "default_value": "container",
                    "return_format": "value",
                    "allow_null": 0,
                    "multiple": 0,
                    "ui": 0,
                    "wrapper": { "width": "20" }
                },
                {
                    "key": "field_ccn_sv_item_number",
                    "label": "Number (not displayed)",
                    "name": "number",
                    "type": "text",
                    "instructions": "Kept for old content: the cards carry no sequence.",
